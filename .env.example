# ============================================================================
# PROZ MOVIE — ENVIRONMENT CONFIGURATION TEMPLATE
# YOUR WORLD. YOUR ENTERTAINMENT.
# ============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="PROZ MOVIE"
NEXT_PUBLIC_APP_TAGLINE="YOUR WORLD. YOUR ENTERTAINMENT."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Database & Auth (Get these from your Supabase Project Settings)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Signed Video Playback & DRM Security
JWT_PLAYBACK_SECRET="proz-movie-playback-session-signature-secret-key-32chars"
PLAYBACK_SESSION_TTL_SECONDS="14400" # 4 Hours

# 18+ Restricted Zone Compliance Toggle
# Set to 'true' only when age verification and legal compliance are configured
ENABLE_RESTRICTED_ZONE="true"
PARENTAL_DEFAULT_PIN="0000"

# Payment Provider Integration (stripe, razorpay, or mock)
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# TMDB Metadata API Integration (Optional - for rich movie data enrichment)
TMDB_API_KEY="your_tmdb_api_key_here"

# Admin Dashboard Protection
ADMIN_BOOTSTRAP_EMAIL="admin@prozmovie.com"
ADMIN_BOOTSTRAP_PASSWORD="proz-admin-secure-passphrase-2026"
ADMIN_MASTER_EMAIL="admin@prozmovie.com"
ADMIN_ACCESS_KEY="proz-admin-secure-passphrase-2026"
