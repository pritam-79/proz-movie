YOUTUBE_API_KEY=""

# Video Infrastructure — Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=""

# Video Infrastructure — Mux Video Adapter
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Payment Gateway — Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
