# Application Environment
APP_URL="https://proz-movie.vercel.app"
APP_ENV="development"
NEXT_PUBLIC_APP_NAME="PROZ MOVIE"
NEXT_PUBLIC_APP_TAGLINE="YOUR WORLD. YOUR ENTERTAINMENT."
